{
  "name": "telegrampogobot",
  "version": "0.9.8",
  "description": "A Telegram Pokemon Go Raid Bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/robverhoef/PoGoTelegramBot.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env --disable-warning=DeprecationWarning index.js",
    "dev": "node --env-file=.env --disable-warning=DeprecationWarning --inspect=0.0.0.0:9229 --watch index.js",
    "eslint": "node_modules/.bin/eslint ./*.js ./models ./wizards ./util; exit 0",
    "eslintfix": "node_modules/.bin/eslint --fix ./*.js ./models ./wizards ./util; exit 0",
    "dbupdate": "node_modules/.bin/sequelize db:migrate",
    "checklocales": "./checktranslations.js",
    "test": "cross-env NODE_ENV=test node_modules/.bin/mocha --reporter spec --exit tests"
  },
  "author": "rob verhoef",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.13.5",
    "dotenv": "^16.6.1",
    "globals": "^16.5.0",
    "i18n": "^0.15.3",
    "metaphone": "^2.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "mysql2": "^3.15.3",
    "sequelize": "^6.37.7",
    "telegraf": "^4.16.3",
    "telegraf-i18n": "^6.6.0",
    "telegraf-session-mysql": "^5.3.0"
  },
  "devDependencies": {
    "chai": "^5.3.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "mocha": "^11.7.5",
    "sequelize-cli": "^6.6.3"
  },
  "packageManager": "pnpm@9.15.2+sha512.93e57b0126f0df74ce6bff29680394c0ba54ec47246b9cf321f0121d8d9bb03f750a705f24edc3c1180853afd7c2c3b94196d0a3d53d3e069d9e2793ef11f321",
  "pnpm": {
    "overrides": {
      "mysql2@<3.9.4": ">=3.9.4",
      "mysql2@<3.9.7": ">=3.9.7",
      "mysql2@<3.9.8": ">=3.9.8",
      "mysql2@<3.9.3": ">=3.9.3",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "validator@<13.15.20": ">=13.15.20",
      "@messageformat/runtime@=3.0.1": ">=3.0.2",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "validator@<13.15.22": ">=13.15.22"
    }
  }
}
